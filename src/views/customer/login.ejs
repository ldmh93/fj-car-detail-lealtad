<%- include('../partials/head') %>
<div class="narrow">
  <img class="hero-logo" src="/images/logo.png" alt="Logo de <%= config.businessName %>" width="110" height="132">
  <h1 class="center">Entra a tu tarjeta</h1>
  <% if (sessionEnded) { %><div class="alert alert-info" role="status">Inicia sesión para continuar. Si ya habías entrado, tu sesión terminó.</div><% } %>
  <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
  <form class="card" method="post" action="/entrar" data-busy>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="next" value="<%= next %>">
    <div class="field">
      <label for="phone">Teléfono celular</label>
      <input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required value="<%= values.phone || '' %>">
    </div>
    <div class="field">
      <label for="password">Contraseña</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required>
    </div>
    <button class="btn btn-lg btn-block" type="submit">Entrar</button>
  </form>
  <p class="center">¿Aún no tienes tarjeta? <a href="/registro">Créala aquí</a></p>
  <p class="center small muted">¿Olvidaste tu contraseña? Pide en el negocio que te den una temporal.</p>
</div>
<%- include('../partials/foot') %>
