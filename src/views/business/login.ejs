<%- include('../partials/head') %>
<div class="narrow">
  <img class="hero-logo" src="/images/logo.png" alt="Logo de <%= config.businessName %>" width="110" height="132">
  <h1 class="center">Acceso del negocio</h1>
  <% if (expired) { %><div class="alert alert-warn" role="status">Tu sesión venció por seguridad. Inicia sesión de nuevo.</div><% } %>
  <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
  <% if (noUsers) { %>
    <div class="alert alert-info">Todavía no hay cuentas del negocio. Créala desde la computadora con <code>npm run crear-usuario</code> (ver README).</div>
  <% } %>
  <form class="card" method="post" action="/negocio/entrar" data-busy>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="next" value="<%= next %>">
    <div class="field">
      <label for="username">Usuario</label>
      <input id="username" name="username" type="text" autocomplete="username" autocapitalize="none" spellcheck="false" required value="<%= values.username || '' %>">
    </div>
    <div class="field">
      <label for="password">Contraseña</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required>
    </div>
    <button class="btn btn-lg btn-block" type="submit">Entrar al panel</button>
  </form>
  <p class="center small"><a href="/">¿Eres cliente? Ve a tu tarjeta</a></p>
</div>
<%- include('../partials/foot') %>
