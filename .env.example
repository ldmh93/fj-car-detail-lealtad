# Copia este archivo como .env y ajusta los valores. Nunca subas .env a Git.
# En Vercel, estos mismos nombres se configuran en Settings → Environment Variables.

# Nombre del negocio (aparece en las pantallas y en el mensaje para compartir)
BUSINESS_NAME=FJ Car Detail

# Recompensa al completar 10 sellos (se lee como "recibe ...")
REWARD_TEXT=un lavado gratis

# Dirección pública de la app, sin "/" al final. Se usa en el enlace de registro,
# en los QR y en las etiquetas NFC. En Vercel, si no la pones, se usa el dominio del proyecto.
BASE_URL=http://localhost:3000

PORT=3000

# Secreto para firmar las sesiones: mínimo 32 caracteres aleatorios.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=cambia-esto-por-un-valor-aleatorio-largo

# Base de datos en Turso (obligatoria en Vercel). Se obtienen con:
#   turso db show <nombre> --url
#   turso db tokens create <nombre>
# Si las dejas vacías, en tu computadora se usa el archivo local DATABASE_PATH.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Archivo SQLite local (solo cuando no hay TURSO_DATABASE_URL)
DATABASE_PATH=data/lealtad.sqlite

# Zona horaria para fechas y el resumen "hoy"
TIME_ZONE=America/Mexico_City

# Fuera de Vercel: NODE_ENV=production activa cookies seguras (solo HTTPS)
# y TRUST_PROXY=true es necesario detrás de un proxy con HTTPS.
NODE_ENV=development
TRUST_PROXY=false
# SECURE_COOKIES=true
